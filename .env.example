# Limen — environment variables for local development.
# Copy to .env and fill in the values printed by the zitadel bootstrap script.

# --- Database -----------------------------------------------------------------
# Runtime app role DSN (Phase 3 creates limen_app; until then, the bootstrap
# `limen` superuser works fine for development).
LIMEN_DB_DSN=postgres://limen:limen_dev@localhost:5432/limen?sslmode=disable
LIMEN_DB_MAX_OPEN_CONNS=25
LIMEN_DB_MAX_IDLE_CONNS=5
LIMEN_DB_CONN_MAX_LIFETIME=30m

# --- Crypto (Phase 2) ---------------------------------------------------------
# 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
LIMEN_TOKEN_ENCRYPTION_KEY=

# --- OIDC / Zitadel (Phase 4+) ------------------------------------------------
LIMEN_OIDC_ISSUER=http://localhost:8081
# Filled in by scripts/zitadel-bootstrap (see .bootstrap-out.env).
LIMEN_OIDC_PORTAL_CLIENT_ID=
LIMEN_OIDC_PORTAL_SCOPES=openid profile email
# PAT for Zitadel Management API — only required for the DCR proxy (Phase 5).
LIMEN_OIDC_MGMT_PAT=

# --- Gateway ------------------------------------------------------------------
LIMEN_BASE_URL=http://localhost:8080
